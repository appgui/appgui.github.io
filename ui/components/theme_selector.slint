// Theme selector menu component
// Displays: Yin-Yang (auto), Sun (light), or Moon (dark)
export component ThemeSelector inherits Rectangle {
    in property <int> theme-mode: 0;
  // 0=auto, 1=light, 2=dark
  in property <color> icon-color: #94a3b8;
    in property <color> hover-bg: #334155;

    callback clicked();

    width: 36px;
    height: 36px;

    touch := TouchArea {
        mouse-cursor: MouseCursor.pointer;
        clicked => {
            root.clicked();
        }

        Rectangle {
            background: touch.has-hover ? root.hover-bg : transparent;
            border-radius: 4px;
            animate background { duration: 140ms; }

            if root.theme-mode == 0: Path {
        // Auto mode - Yin Yang symbol
        commands: "M 8 4 A 4 4 0 0 1 8 12 A 2 2 0 0 0 8 8 A 2 2 0 0 1 8 4 M 8 6 A 1 1 0 1 0 8 6.01 M 8 10 A 1 1 0 1 0 8 10.01";
                fill: root.icon-color;
                viewbox-width: 16;
                viewbox-height: 16;
            }

            if root.theme-mode == 1: Path {
        // Light mode - Sun symbol
        commands: "M 8 11 A 3 3 0 1 0 8 5 A 3 3 0 0 0 8 11 M 8 0 L 8 2 M 8 14 L 8 16 M 0 8 L 2 8 M 14 8 L 16 8 M 2.3 2.3 L 3.7 3.7 M 12.3 12.3 L 13.7 13.7 M 2.3 13.7 L 3.7 12.3 M 12.3 3.7 L 13.7 2.3";
                stroke: root.icon-color;
                stroke-width: 1.5px;
                viewbox-width: 16;
                viewbox-height: 16;
            }

            if root.theme-mode == 2: Path {
        // Dark mode - Moon symbol
        commands: "M 12 9 A 5 5 0 1 1 7 4 A 3.5 3.5 0 0 0 12 9 Z";
                fill: root.icon-color;
                viewbox-width: 16;
                viewbox-height: 16;
            }
        }
    }
}
