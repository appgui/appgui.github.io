export component CustomToggleButton inherits Rectangle {
    in property <string> text;
    in property <bool> is-dark: true;
    callback clicked;
    callback long-pressed;

    height: 76px;
    border-radius: 12px;
    background: touch.pressed ? (root.is-dark ? #059669 : #047857) : touch.has-hover ? (root.is-dark ? #10b981cc : #10b981) : (root.is-dark ? #10b981 : #34d399);

    animate background { duration: 140ms; }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }

        // Use pointer-event for fine-grained control
        pointer-event(pe) => {
            if (pe.kind == PointerEventKind.down) {
                long_press_timer.running = true;
            } else if (pe.kind == PointerEventKind.up || pe.kind == PointerEventKind.cancel) {
                long_press_timer.running = false;
            }
        }
    }

    long_press_timer := Timer {
        interval: 500ms;
        running: false;
        triggered => {
            root.long-pressed();
            self.running = false;
        }
    }

    Text {
        text: root.text;
        color: white;
        font-size: 20px;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}
