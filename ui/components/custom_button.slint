export component CustomToggleButton inherits Rectangle {
    in property <string> text;
    in property <bool> is-dark: true;
    callback clicked;

    height: 76px;
    border-radius: 12px;
    background: touch.pressed ?
                    (root.is-dark ? #059669 : #047857) :
                touch.has-hover ?
                    (root.is-dark ? #10b981cc : #10b981) :
                    (root.is-dark ? #10b981 : #34d399);

    animate background { duration: 140ms; }

    touch := TouchArea {
        mouse-cursor: pointer;  // Show pointer cursor on hover
        clicked => { root.clicked(); }
    }

    Text {
        text: root.text;
        color: white;
        font-size: 20px;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}
