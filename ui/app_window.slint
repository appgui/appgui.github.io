import { ScrollView } from "std-widgets.slint";
import { CustomToggleButton } from "components/custom_button.slint";

export component AppWindow inherits Window {
  title: "xPlatform";
  icon: @image-url("../assets/icon.png");
  background: #0f172a;
  preferred-width: 360px;
  preferred-height: 460px;
  min-width: 360px;
  min-height: 460px;
  no-frame: false;

  in property <bool> is-mobile: false;
  in-out property <string> display-value: "—";
  in-out property <string> display-label: "—";
  in-out property <string> button-text: "Show Uptime";
  in-out property <bool> is-fullscreen: false;

  in-out property <length> safe-inset-left: 0px;
  in-out property <length> safe-inset-top: 0px;
  in-out property <length> safe-inset-right: 0px;
  in-out property <length> safe-inset-bottom: 0px;

  callback toggle-mode();
  callback quit();
  callback toggle-fullscreen();

  property <length> toolbar-height: 40px;
  property <length> submenu-height: 64px;

  VerticalLayout {
    ScrollView {
      vertical-stretch: 1;
      VerticalLayout {
        padding-left: 32px + root.safe-inset-left;
        padding-right: 32px + root.safe-inset-right;
        padding-top: 32px + root.safe-inset-top;
        padding-bottom: 32px;
        spacing: 32px;
        alignment: center;

        VerticalLayout {
          spacing: 6px;
          alignment: center;
          Text { text: root.display-value; font-size: 56px; color: #38bdf8; horizontal-alignment: center; }
          Text { text: root.display-label; font-size: 18px; color: #94a3b8; horizontal-alignment: center; }
        }

        CustomToggleButton {
          text: root.button-text;
          clicked => { root.toggle-mode(); }
        }
      }
    }

    HorizontalLayout {
      height: root.toolbar-height;
      padding-left: 12px + root.safe-inset-left;
      padding-right: 12px + root.safe-inset-right;

      icon_touch := TouchArea {
        width: 36px; height: 36px;
        mouse-cursor: MouseCursor.pointer;
        clicked => { submenu_popup.show(); }
        Image {
          source: @image-url("../assets/icon.svg");
          width: 24px; height: 24px;
        }
      }

      Rectangle { horizontal-stretch: 1; }

      fullscreen_btn := TouchArea {
        width: 36px; height: 36px;
        mouse-cursor: MouseCursor.pointer;
        clicked => { root.toggle-fullscreen(); }
        Rectangle {
          background: fullscreen_btn.has-hover ? #334155 : transparent;
          border-radius: 4px;

          if !root.is-fullscreen : Path {
            commands: "M 3 5 L 3 3 L 5 3 M 11 3 L 13 3 L 13 5 M 13 11 L 13 13 L 11 13 M 5 13 L 3 13 L 3 11";
            stroke: #94a3b8; stroke-width: 1.5px;
            viewbox-width: 20; viewbox-height: 20;
            x: 8px; y: 8px;
          }

          if root.is-fullscreen : Path {
            commands: "M 5 3 L 5 5 L 3 5 M 13 5 L 11 5 L 11 3 M 11 13 L 11 11 L 13 11 M 3 11 L 5 11 L 5 13";
            stroke: #94a3b8; stroke-width: 1.5px;
            viewbox-width: 20; viewbox-height: 20;
            x: 8px; y: 8px;
          }
        }
      }
    }

    Rectangle {
      height: root.safe-inset-bottom;
      background: #0f172a;
    }
  }

  submenu_popup := PopupWindow {
    x: 12px + root.safe-inset-left;
    y: root.height - root.toolbar-height - root.safe-inset-bottom - root.submenu-height;
    width: 150px;
    close-policy: close-on-click-outside;
    Rectangle {
      background: #1e293b; border-radius: 6px;
      drop-shadow-blur: 8px; drop-shadow-color: #00000080; drop-shadow-offset-y: 2px;
      VerticalLayout {
        padding: 4px;
        about_touch := TouchArea {
          height: 28px;
          clicked => { submenu_popup.close(); about_popup.show(); }
          Rectangle {
            background: about_touch.has-hover ? #334155 : transparent;
            border-radius: 4px;
            Text { text: "About"; color: #e2e8f0; font-size: 13px; x: 12px; vertical-alignment: center; }
          }
        }
        exit_touch := TouchArea {
          height: 28px;
          clicked => { submenu_popup.close(); root.quit(); }
          Rectangle {
            background: exit_touch.has-hover ? #334155 : transparent;
            border-radius: 4px;
            Text { text: "Exit"; color: #e2e8f0; font-size: 13px; x: 12px; vertical-alignment: center; }
          }
        }
      }
    }
  }

  about_popup := PopupWindow {
    x: 12px + root.safe-inset-left;
    y: root.height - root.toolbar-height - root.safe-inset-bottom - 200px;
    width: 220px;
    close-policy: close-on-click-outside;
    Rectangle {
      background: #1e293b; border-radius: 8px;
      drop-shadow-blur: 8px; drop-shadow-color: #00000080; drop-shadow-offset-y: 2px;
      VerticalLayout {
        padding: 24px; spacing: 12px; alignment: center;
        Image { source: @image-url("../assets/icon.svg"); width: 48px; height: 48px; }
        Text { text: "xPlatform"; color: #f1f5f9; font-size: 16px; font-weight: 700; horizontal-alignment: center; }
        Text { text: "v0.0.1"; color: #94a3b8; font-size: 13px; horizontal-alignment: center; }
        TouchArea {
          height: 30px;
          clicked => { about_popup.close(); }
          Rectangle {
            background: #334155; border-radius: 6px;
            Text { text: "OK"; color: #e2e8f0; font-size: 13px; horizontal-alignment: center; vertical-alignment: center; }
          }
        }
      }
    }
  }
}
