import { ScrollView, LineEdit, ComboBox } from "std-widgets.slint";
import { ThemeSelector } from "components/theme_selector.slint";
import { FullscreenToggle } from "components/fullscreen_toggle.slint";
import { LoginView } from "components/login_view.slint";

export component AppWindow inherits Window {
    title: "appGUI";
    icon: @image-url("../assets/icon.svg");
    background: root.bg-primary;
    preferred-width: 500px;
    preferred-height: 500px;
    min-width: 500px;
    min-height: 500px;

    in property <bool> is-mobile: false;
    // Set to false on web/WASM targets where local sysinfo is unavailable.
    in property <bool> has-local-source: true;

    in-out property <int> theme-mode: 0;
    in property <bool> system-is-dark: true;
    in-out property <bool> is-fullscreen: false;
    in-out property <string> display-value: "—";
    in-out property <string> display-label: "—";
    // 0 = Uptime, 1 = CPU Temperature, 2 = Free RAM
    in-out property <int> display-mode: 0;
    // Always holds uptime for the active source — used by tray/notification.
    in-out property <string> tray-text: "—";

    // Data source configuration — committed values (persisted to Rust).
    in-out property <int> data-source-mode: 0;     // 0 = local, 1 = remote
    in-out property <string> data-source-url: "";
    // Pending edits shown inside the popup before Save is confirmed.
    in-out property <int> pending-source-mode: 0;
    in-out property <string> pending-source-url: "";

    property <bool> settings-open: false;

    in-out property <length> safe-inset-left: 0px;
    in-out property <length> safe-inset-top: 0px;
    in-out property <length> safe-inset-right: 0px;
    in-out property <length> safe-inset-bottom: 0px;

    // ── App mode: 0 = normal (RAM/Uptime), 1 = secret login ──
  in-out property <int> app-mode: 0;

    callback set-display-mode(int);
    callback quit();
    callback toggle-fullscreen();
    callback cycle-theme();
    callback show-notification(string, string);
    callback update-tray(string);
    callback connect-anonymous(string);
    callback login-success();
    // Fired when user confirms a data source change in the popup.
    callback save-data-source(int, string);

    property <length> toolbar-height: 64px;
    property <bool> is-dark: root.theme-mode == 2 || (root.theme-mode == 0 && root.system-is-dark);

    property <color> bg-primary: root.is-dark ? #0f172a : #f8fafc;
    property <color> bg-secondary: root.is-dark ? #1e293b : #e2e8f0;
    property <color> text-primary: root.is-dark ? #f1f5f9 : #0f172a;
    property <color> text-secondary: root.is-dark ? #94a3b8 : #64748b;
    property <color> text-accent: root.is-dark ? #38bdf8 : #0284c7;
    property <color> hover-bg: root.is-dark ? #334155 : #cbd5e1;
    property <color> popup-bg: root.is-dark ? #1e293b : #ffffff;

    VerticalLayout {
        padding-top: root.safe-inset-top;
        padding-left: root.safe-inset-left;
        padding-right: root.safe-inset-right;

        Rectangle {
            vertical-stretch: 1;

            // NORMAL MODE
      if (root.app-mode == 0): normal_view := VerticalLayout {
                padding: 32px;
                spacing: 32px;
                alignment: center;

                VerticalLayout {
                    spacing: 6px;
                    Text {
                        text: root.display-value;
                        font-size: 44px;
                        color: root.text-accent;
                        horizontal-alignment: center;
                    }

                    Text {
                        text: root.data-source-mode == 0 ? "Local" : "Remote";
                        font-size: 18px;
                        color: root.text-secondary;
                        horizontal-alignment: center;
                    }
                }

                ComboBox {
                    model: ["Uptime", "CPU Temperature", "Free RAM"];
                    current-index: root.display-mode;
                    selected(value) => {
                        root.display-mode = self.current-index;
                        root.set-display-mode(self.current-index);
                    }
                }
            }

            // SECRET LOGIN MODE
      if (root.app-mode == 1): login_view := LoginView {
                width: 100%;
                height: 100%;
                is-dark: root.is-dark;
                connect => {
                    root.connect-anonymous(self.server-url);
                }
                cancel => {
                    root.app-mode = 0;
                }
            }
        }

        // Toolbar (always visible)
    Rectangle {
            height: root.toolbar-height;
            background: root.bg-secondary;

            HorizontalLayout {
                padding-left: 24px;
                padding-right: 24px;
                alignment: space-between;

                VerticalLayout {
                    alignment: center;
                    ThemeSelector {
                        theme-mode: root.theme-mode;
                        icon-color: root.text-secondary;
                        hover-bg: root.hover-bg;
                        clicked => {
                            theme_popup.show();
                        }
                    }
                }

                VerticalLayout {
                    alignment: center;
                    menu_ta := TouchArea {
                        clicked => {
                            submenu_popup.show();
                        }
                        Rectangle {
                            width: 36px;
                            height: 36px;
                            background: menu_ta.has-hover ? root.hover-bg : transparent;
                            border-radius: 4px;
                            Image {
                                source: @image-url("../assets/icon.svg");
                                width: 24px;
                                height: 24px;
                                colorize: root.text-secondary;
                            }
                        }
                    }
                }

                VerticalLayout {
                    alignment: center;
                    FullscreenToggle {
                        is-fullscreen: root.is-fullscreen;
                        icon-colour: root.text-secondary;
                        hover-bg: root.hover-bg;
                        clicked => {
                            root.toggle-fullscreen();
                        }
                    }
                }
            }
        }

        Rectangle {
            height: root.safe-inset-bottom;
            background: root.bg-secondary;
        }
    }

    // ── Popups ──
  theme_popup := PopupWindow {
        x: 24px;
        y: root.height - root.toolbar-height - root.safe-inset-bottom - 130px;
        width: 140px;
        Rectangle {
            background: root.popup-bg;
            border-radius: 6px;
            VerticalLayout {
                padding: 4px;
                TouchArea {
                    height: 36px;
                    clicked => {
                        root.theme-mode = 0;
                        theme_popup.close();
                        root.cycle-theme();
                    }
                    Text {
                        text: "Auto";
                        color: root.text-primary;
                        x: 12px;
                        vertical-alignment: center;
                    }
                }

                TouchArea {
                    height: 36px;
                    clicked => {
                        root.theme-mode = 1;
                        theme_popup.close();
                        root.cycle-theme();
                    }
                    Text {
                        text: "Light";
                        color: root.text-primary;
                        x: 12px;
                        vertical-alignment: center;
                    }
                }

                TouchArea {
                    height: 36px;
                    clicked => {
                        root.theme-mode = 2;
                        theme_popup.close();
                        root.cycle-theme();
                    }
                    Text {
                        text: "Dark";
                        color: root.text-primary;
                        x: 12px;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }

    submenu_popup := PopupWindow {
        x: (root.width - 150px) / 2;
        y: root.height - root.toolbar-height - root.safe-inset-bottom - 90px;
        width: 150px;
        Rectangle {
            background: root.popup-bg;
            border-radius: 6px;
            VerticalLayout {
                padding: 4px;
                settings_item := TouchArea {
                    height: 36px;
                    clicked => {
                        submenu_popup.close();
                        root.pending-source-mode = root.data-source-mode;
                        root.pending-source-url = root.data-source-url;
                        root.settings-open = true;
                    }
                    Rectangle {
                        background: settings_item.has-hover ? root.hover-bg : transparent;
                        border-radius: 4px;
                        Text {
                            text: "Settings";
                            color: root.text-primary;
                            x: 12px;
                            vertical-alignment: center;
                        }
                    }
                }

                exit_item := TouchArea {
                    height: 36px;
                    clicked => {
                        submenu_popup.close();
                        root.quit();
                    }
                    Rectangle {
                        background: exit_item.has-hover ? root.hover-bg : transparent;
                        border-radius: 4px;
                        Text {
                            text: "Exit";
                            color: root.text-primary;
                            x: 12px;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }
    }

    if root.settings-open: Rectangle {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        background: #00000066;

        // Absorb all clicks outside the card — prevents dismiss and passthrough.
        TouchArea {
            width: 100%;
            height: 100%;
        }

        // Centred card — VerticalLayout determines height from content.
        VerticalLayout {
            alignment: center;
            HorizontalLayout {
                alignment: center;
                Rectangle {
                    width: 300px;
                    background: root.popup-bg;
                    border-radius: 8px;

                    VerticalLayout {
                        padding: 20px;
                        spacing: 12px;

                        Text {
                            text: "Settings";
                            color: root.text-primary;
                            font-size: 14px;
                            font-weight: 700;
                            horizontal-alignment: center;
                        }

                        ComboBox {
                            model: ["Local", "Remote"];
                            current-index: root.pending-source-mode;
                            enabled: root.has-local-source;
                            selected(value) => {
                                root.pending-source-mode = self.current-index;
                            }
                        }

                        if root.pending-source-mode == 0: Rectangle {
                            height: 32px;
                            border-radius: 4px;
                            border-width: 1px;
                            border-color: root.text-secondary;
                            background: root.bg-secondary;
                            Text {
                                x: 8px;
                                text: "host";
                                color: root.text-secondary;
                                vertical-alignment: center;
                            }
                        }

                        url-input := LineEdit {
                            visible: root.pending-source-mode == 1;
                            height: root.pending-source-mode == 1 ? 32px : 0px;
                            text: root.pending-source-url;
                            placeholder-text: "https://...";
                            edited(t) => {
                                root.pending-source-url = t;
                            }
                        }

                        HorizontalLayout {
                            spacing: 8px;
                            height: 36px;

                            TouchArea {
                                horizontal-stretch: 1;
                                clicked => {
                                    root.data-source-mode = root.pending-source-mode;
                                    root.data-source-url = root.pending-source-url;
                                    root.save-data-source(root.pending-source-mode, root.pending-source-url);
                                    root.settings-open = false;
                                }
                                Rectangle {
                                    border-radius: 4px;
                                    background: root.text-accent;
                                    Text {
                                        text: "Save";
                                        color: white;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }
                            }

                            TouchArea {
                                horizontal-stretch: 1;
                                clicked => {
                                    root.settings-open = false;
                                }
                                Rectangle {
                                    border-radius: 4px;
                                    background: root.bg-secondary;
                                    Text {
                                        text: "Cancel";
                                        color: root.text-primary;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    // Called from Rust after successful anonymous login
  login-success => {
        root.app-mode = 0;
    }
}
