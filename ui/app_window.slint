import { ScrollView } from "std-widgets.slint";
import { CustomToggleButton } from "components/custom_button.slint";

export component AppWindow inherits Window {
    title: "SlintXPlatform";
    icon: @image-url("../assets/icon.png");
    background: #0f172a;
    preferred-width: 360px;
    preferred-height: 460px;
    min-width: 360px;
    min-height: 460px;

    no-frame: !is-mobile;

    in property <bool> is-mobile: false;
    in-out property <string> display-value: "—";
    in-out property <string> display-label: "—";
    in-out property <string> button-text: "Show Uptime";
    in-out property <bool> is-maximized: false;
    in-out property <bool> is-fullscreen: false;
    in-out property <bool> expecting-second-click: false;

    callback toggle-mode();
    callback quit();
    callback start-drag();
    callback minimize();
    callback maximize();
    callback toggle-fullscreen();
    callback start-resize-drag(direction: string);

    // ─── Main layout ────────────────────────────────────────────────────────
    // DIRECT child of Window – no wrapper Rectangle.
    // On Wayland, drag_window() carries the serial of the most recent pointer
    // event.  Any intermediate Rectangle that re-layouts before the TouchArea
    // fires causes that serial to go stale and the compositor silently rejects
    // the move.  Same applies to drag_resize_window().
    VerticalLayout {
        // Desktop titlebar – hidden when mobile or fullscreen
        if !root.is-mobile && !root.is-fullscreen : Rectangle {
            height: 32px;
            vertical-stretch: 0;
            clip: true;

            HorizontalLayout {
                vertical-stretch: 0;

                // App-icon / menu button
                icon_btn := TouchArea {
                    width: 28px;
                    height: 32px;
                    mouse-cursor: MouseCursor.pointer;
                    clicked => { submenu_popup.show(); }
                    Image {
                        source: @image-url("../assets/icon.png");
                        width: 16px; height: 16px; x: 6px; y: 8px;
                    }
                }

                // Draggable title area with double-click to maximize
                title_drag_area := TouchArea {
                    horizontal-stretch: 1;
                    height: 32px;
                    mouse-cursor: MouseCursor.grab;

                    pointer-event(event) => {
                        if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                            if (root.expecting-second-click) {
                                // Double-click: toggle maximize
                                root.maximize();
                                root.expecting-second-click = false;
                            } else {
                                // Single-click: start drag and expect second click
                                root.start-drag();
                                root.expecting-second-click = true;
                            }
                        } else if (event.kind == PointerEventKind.up && event.button == PointerEventButton.left) {
                            // Reset state after release
                            root.expecting-second-click = false;
                        }
                    }

                    Text {
                        text: "SlintXPlatform";
                        color: #94a3b8; font-size: 12px; vertical-alignment: center;
                    }
                }

                // Window-control buttons
                HorizontalLayout {
                    fullscreen_btn := TouchArea {
                        width: 36px; height: 32px;
                        mouse-cursor: MouseCursor.pointer;
                        clicked => { root.toggle-fullscreen(); }
                        Rectangle {
                            background: fullscreen_btn.has-hover ? #334155 : transparent;
                            if !root.is-fullscreen : Path {
                                commands: "M 10 14 L 10 10 L 14 10 M 22 10 L 26 10 L 26 14 M 26 22 L 26 26 L 22 26 M 14 26 L 10 26 L 10 22";
                                stroke: #94a3b8; stroke-width: 2px;
                                viewbox-width: 36; viewbox-height: 32;
                            }
                            if root.is-fullscreen : Path {
                                commands: "M 14 10 L 14 14 L 10 14 M 26 14 L 22 14 L 22 10 M 22 26 L 22 22 L 26 22 M 10 22 L 14 22 L 14 26";
                                stroke: #94a3b8; stroke-width: 2px;
                                viewbox-width: 36; viewbox-height: 32;
                            }
                        }
                    }

                    minimize_btn := TouchArea {
                        width: 36px; height: 32px;
                        mouse-cursor: MouseCursor.pointer;
                        clicked => { root.minimize(); }
                        Rectangle {
                            background: minimize_btn.has-hover ? #334155 : transparent;
                            Path {
                                commands: "M 8 16 L 28 16";
                                stroke: #94a3b8; stroke-width: 2px;
                                viewbox-width: 36; viewbox-height: 32;
                            }
                        }
                    }

                    maximize_btn := TouchArea {
                        width: 36px; height: 32px;
                        mouse-cursor: MouseCursor.pointer;
                        clicked => { root.maximize(); }
                        Rectangle {
                            background: maximize_btn.has-hover ? #334155 : transparent;
                            if !root.is-maximized : Path {
                                commands: "M 10 8 L 26 8 L 26 24 L 10 24 Z";
                                stroke: #94a3b8; stroke-width: 2px; fill: transparent;
                                viewbox-width: 36; viewbox-height: 32;
                            }
                            if root.is-maximized : Path {
                                commands: "M 13 6 L 27 6 L 27 20 L 13 20 Z M 9 10 L 23 10 L 23 24 L 9 24 Z";
                                stroke: #94a3b8; stroke-width: 2px; fill: transparent;
                                viewbox-width: 36; viewbox-height: 32;
                            }
                        }
                    }

                    close_btn := TouchArea {
                        width: 36px; height: 32px;
                        mouse-cursor: MouseCursor.pointer;
                        clicked => { root.quit(); }
                        Rectangle {
                            background: close_btn.has-hover ? #dc2626 : transparent;
                            Path {
                                commands: "M 10 10 L 26 22 M 26 10 L 10 22";
                                stroke: #94a3b8; stroke-width: 2px;
                                viewbox-width: 36; viewbox-height: 32;
                            }
                        }
                    }
                }
            }
        }

        // Secondary toolbar – visible on mobile OR when fullscreen
        if root.is-mobile || root.is-fullscreen : HorizontalLayout {
            height: 24px;
            padding-left: 8px;
            padding-right: 8px;
            padding-top: 2px;

            TouchArea {
                width: 20px; height: 20px;
                mouse-cursor: MouseCursor.pointer;
                clicked => { submenu_popup.show(); }
                Image {
                    source: @image-url("../assets/icon.png");
                    width: 14px; height: 14px;
                }
            }

            Rectangle { horizontal-stretch: 1; }

            fullscreen_mobile_btn := TouchArea {
                width: 20px; height: 20px;
                mouse-cursor: MouseCursor.pointer;
                clicked => { root.toggle-fullscreen(); }
                Rectangle {
                    background: fullscreen_mobile_btn.has-hover ? #334155 : transparent;
                    border-radius: 2px;
                    if !root.is-fullscreen : Path {
                        commands: "M 3 5 L 3 3 L 5 3 M 11 3 L 13 3 L 13 5 M 13 11 L 13 13 L 11 13 M 5 13 L 3 13 L 3 11";
                        stroke: #94a3b8; stroke-width: 1.5px;
                        viewbox-width: 16; viewbox-height: 16;
                    }
                    if root.is-fullscreen : Path {
                        commands: "M 5 3 L 5 5 L 3 5 M 13 5 L 11 5 L 11 3 M 11 13 L 11 11 L 13 11 M 3 11 L 5 11 L 5 13";
                        stroke: #94a3b8; stroke-width: 1.5px;
                        viewbox-width: 16; viewbox-height: 16;
                    }
                }
            }
        }

        // Main content
        ScrollView {
            vertical-stretch: 1;
            VerticalLayout {
                padding: 32px; spacing: 32px; alignment: center;
                VerticalLayout {
                    spacing: 6px; alignment: center;
                    Text { text: root.display-value; font-size: 56px; color: #38bdf8; horizontal-alignment: center; }
                    Text { text: root.display-label; font-size: 18px; color: #94a3b8; horizontal-alignment: center; }
                }
                CustomToggleButton {
                    text: root.button-text;
                    clicked => { root.toggle-mode(); }
                }
            }
        }
    }

    // ─── Resize handles ─────────────────────────────────────────────────────
    // DIRECT children of Window (not inside any Rectangle).  Positioned with
    // root.width / root.height.  Same serial-freshness requirement as drag.
    // Fire the callback on pointer-down; the compositor owns the resize after
    // that.  No resizing flag or guard logic needed.

    // Top
    Rectangle {
        background: transparent;
        height: 4px; width: root.width; x: 0px; y: 0px;
        TouchArea {
            mouse-cursor: MouseCursor.n_resize;
            pointer-event(event) => {
                if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                    root.start-resize-drag("n");
                }
            }
        }
    }
    // Bottom
    Rectangle {
        background: transparent;
        height: 4px; width: root.width; x: 0px; y: root.height - 4px;
        TouchArea {
            mouse-cursor: MouseCursor.s_resize;
            pointer-event(event) => {
                if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                    root.start-resize-drag("s");
                }
            }
        }
    }
    // Left
    Rectangle {
        background: transparent;
        width: 4px; height: root.height; x: 0px; y: 0px;
        TouchArea {
            mouse-cursor: MouseCursor.w_resize;
            pointer-event(event) => {
                if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                    root.start-resize-drag("w");
                }
            }
        }
    }
    // Right
    Rectangle {
        background: transparent;
        width: 4px; height: root.height; x: root.width - 4px; y: 0px;
        TouchArea {
            mouse-cursor: MouseCursor.e_resize;
            pointer-event(event) => {
                if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                    root.start-resize-drag("e");
                }
            }
        }
    }
    // NW corner
    Rectangle {
        background: transparent;
        width: 8px; height: 8px; x: 0px; y: 0px;
        TouchArea {
            mouse-cursor: MouseCursor.nw_resize;
            pointer-event(event) => {
                if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                    root.start-resize-drag("nw");
                }
            }
        }
    }
    // NE corner
    Rectangle {
        background: transparent;
        width: 8px; height: 8px; x: root.width - 8px; y: 0px;
        TouchArea {
            mouse-cursor: MouseCursor.ne_resize;
            pointer-event(event) => {
                if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                    root.start-resize-drag("ne");
                }
            }
        }
    }
    // SW corner
    Rectangle {
        background: transparent;
        width: 8px; height: 8px; x: 0px; y: root.height - 8px;
        TouchArea {
            mouse-cursor: MouseCursor.sw_resize;
            pointer-event(event) => {
                if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                    root.start-resize-drag("sw");
                }
            }
        }
    }
    // SE corner
    Rectangle {
        background: transparent;
        width: 8px; height: 8px; x: root.width - 8px; y: root.height - 8px;
        TouchArea {
            mouse-cursor: MouseCursor.se_resize;
            pointer-event(event) => {
                if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                    root.start-resize-drag("se");
                }
            }
        }
    }

    // ─── Popups ─────────────────────────────────────────────────────────────

    submenu_popup := PopupWindow {
        x: 8px; y: 56px; width: 150px;
        close-policy: close-on-click-outside;
        Rectangle {
            background: #1e293b; border-radius: 6px;
            VerticalLayout {
                padding: 4px;
                about_touch := TouchArea {
                    height: 28px;
                    clicked => { submenu_popup.close(); about_popup.show(); }
                    Rectangle {
                        background: about_touch.has-hover ? #334155 : transparent;
                        border-radius: 4px;
                        Text { text: "About"; color: #e2e8f0; font-size: 13px; x: 12px; vertical-alignment: center; }
                    }
                }
                exit_touch := TouchArea {
                    height: 28px;
                    clicked => { submenu_popup.close(); root.quit(); }
                    Rectangle {
                        background: exit_touch.has-hover ? #334155 : transparent;
                        border-radius: 4px;
                        Text { text: "Exit"; color: #e2e8f0; font-size: 13px; x: 12px; vertical-alignment: center; }
                    }
                }
            }
        }
    }

    about_popup := PopupWindow {
        x: (root.width - 220px) / 2; y: (root.height - 120px) / 2; width: 220px;
        close-policy: close-on-click-outside;
        Rectangle {
            background: #1e293b; border-radius: 8px;
            VerticalLayout {
                padding: 24px; spacing: 12px; alignment: center;
                Image { source: @image-url("../assets/icon.png"); width: 48px; height: 48px; }
                Text { text: "SlintXPlatform"; color: #f1f5f9; font-size: 16px; font-weight: 700; horizontal-alignment: center; }
                Text { text: "v0.0.1"; color: #94a3b8; font-size: 13px; horizontal-alignment: center; }
                TouchArea {
                    height: 30px; clicked => { about_popup.close(); }
                    Rectangle {
                        background: #334155; border-radius: 6px;
                        Text { text: "OK"; color: #e2e8f0; font-size: 13px; horizontal-alignment: center; vertical-alignment: center; }
                    }
                }
            }
        }
    }
}
